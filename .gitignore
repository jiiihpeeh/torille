/target
.cache/
/libvoikko-4.3.3/

# Generated class reports. Regenerate with
#   python3 tools/report_by_class.py --split reports/
/reports/

# Python bytecode from the Wiktionary fetcher
__pycache__/
*.pyc

# Local-only Kotus reference document. The engine and codegen read
# data/catalogue.csv, which is generated from the Omorfi/Voikko oracles; this
# file is kept on developer machines for provenance but is not distributed.
data/kotus-tyypit.txt

# Binary maps are generated artefacts. They live on the orphan `maps` branch
# (`cargo run -p torille-maps -- fetch` restores them; `publish` replaces it),
# never in normal history, so the repository only ever holds the current
# versions.
maps/*.bin.gz
maps/*.bin

# Generated noun lexicon and examples. Rebuild with
#   python3 tools/oracle/build_nomine_lexicon.py -o data/kotus_nomines.sqlite
data/kotus_nomines*.sqlite*
data/kotus_nomines_example.*
data/kotus_nomines.json

# Generated verb lexicon. Rebuild with
#   python3 tools/oracle/build_verb_lexicon.py -o data/kotus_verbit.sqlite
data/kotus_verbit.sqlite*

# Firefox extension: build artefacts, dependencies, the demo's wasm artifacts
extensions/firefox/node_modules/
extensions/firefox/dist/
extensions/chromium/node_modules/
extensions/chromium/dist/
torille-wasm/demo/node_modules/
torille-wasm/demo/dist/

# Kilo agent worktrees. They are live checkouts, not build output, and
# may be nested inside the source trees; keep them out of git status and
# editor indexes.
**/.kilo/

# Criterion's local target output (the bench runs don't need to be tracked)
target/criterion/

# Downloaded Finnish Gutenberg corpus (tools/fetch_finnish_books.py)
torille-wasm/demo/books/

# Experimental derivative-flagged sanalista copy.
data/nykysuomensanalista_derivedtest.csv

# Generated derivative-filled word list (tools/apply_all_derivations.py).
data/nykysuomensanalista_derivates.csv

# Large local artifacts removed from Git history. Keep them on disk if needed;
# regenerate the extension bundles with the demo/build scripts.
/extensions/chromium/torille-chromium.zip
/extensions/firefox/torille-firefox.xpi
extensions/chromium/torille_wasm_bg.wasm

# Large generated artifacts (local only)
data/all_forms.csv
data/wiktionary_finnish_morph.jsonl

# Ad-hoc wasm demo probes and the compiled protocol module. The probes and the
# two-panel smoke are local debugging aids (the smoke needs puppeteer-core and
# a server on :8765); protocol.js is built from protocol.ts.
torille-wasm/demo/probe*.mjs
torille-wasm/demo/dbg-*.mjs
torille-wasm/demo/db_*.mjs
torille-wasm/demo/profile.html
torille-wasm/demo/smoke-two-panels.mjs
torille-wasm/protocol.js

# Local Finnish Wiktionary dump and the index/database derived from it.
# The dump is hundreds of MB and is not part of the shipped library; the
# scripts under tools/ regenerate the small extracts they need.
data/fiwiktionary-*.xml
data/fiwiktionary_*.db
data/fiwiktionary_index.json
