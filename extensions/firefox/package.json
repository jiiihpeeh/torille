{
  "name": "torille-firefox",
  "version": "1.0.0",
  "description": "A Manifest V3 Firefox extension that turns the torille wasm into a context-menu spell-checker.",
  "main": "dist/background/background.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.options.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "typescript": "^5.6.3",
    "solid-js": "^1.9.0",
    "esbuild": "^0.27.0",
    "esbuild-plugin-solid": "^0.6.0",
    "babel-preset-solid": "^1.9.15"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
