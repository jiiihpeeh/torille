{
  "name": "torille-chromium",
  "version": "1.0.0",
  "description": "A Manifest V3 Chromium extension that turns the torille wasm into a context-menu spell-checker.",
  "main": "dist/background/background.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
