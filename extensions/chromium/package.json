    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
